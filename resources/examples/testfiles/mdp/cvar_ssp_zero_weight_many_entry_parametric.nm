mdp

const int K;
const int L;
const int H;
const int E = floor(pow(2, K));

module main
    phase : [0..6] init 0;
    depth : [0..K] init 0;
    entry : [0..E-1] init 0;
    position : [0..L-1] init 0;
    remaining : [0..H-1] init 0;

    [pick] phase=0 & depth<K -> 1/2 : (depth'=depth+1) & (entry'=2*entry)
                              + 1/2 : (depth'=depth+1) & (entry'=2*entry+1);
    [gate] phase=0 & depth=K -> (phase'=1);

    [enter] phase=1 -> (entry+1)/(2*(E+1)) : (phase'=3) & (entry'=0)
                     + (1-(entry+1)/(2*(E+1))) : (phase'=2) & (entry'=0);

    [advance] phase=2 & position<L-1 -> 1/2 : (position'=position)
                                         + 1/2 : (position'=position+1);
    [good] phase=2 & position=L-1 -> 3/4 : (phase'=3) & (position'=0)
                                     + 1/4 : (phase'=4) & (position'=0);
    [alternative] phase=2 & position=L-1 -> 11/16 : (phase'=3) & (position'=0)
                                            + 5/16 : (phase'=4) & (position'=0);

    [low_finish] phase=3 -> (phase'=6);
    [high_boundary] phase=4 -> (phase'=5) & (remaining'=H-1);
    [high_path] phase=5 & remaining>1 -> (remaining'=remaining-1);
    [high_path] phase=5 & remaining=1 -> (phase'=6) & (remaining'=0);
    [] phase=6 -> (phase'=6);
endmodule

label "goal" = phase=6;

rewards "cost"
    [pick] true : 1;
    [gate] true : 1;
    [low_finish] true : 1;
    [high_boundary] true : 1;
    [high_path] true : 1;
endrewards
