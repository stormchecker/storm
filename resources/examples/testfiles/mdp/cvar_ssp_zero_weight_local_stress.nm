mdp

const int N;

module main
    s : [0..N+4] init 0;

    [enter] s=0 -> (s'=1);

    [to_a] s>=1 & s<N -> 1/2 : (s'=N+1) + 1/2 : (s'=s+1);
    [to_b] s>=1 & s<N -> 1/2 : (s'=N+2) + 1/2 : (s'=s+1);
    [to_a] s=N -> 1/2 : (s'=N+1) + 1/2 : (s'=N+3);
    [to_b] s=N -> 1/2 : (s'=N+2) + 1/2 : (s'=N+3);

    [a_done] s=N+1 -> (s'=N+4);
    [b_done] s=N+2 -> (s'=N+4);
    [c_done] s=N+3 -> (s'=N+4);
    [] s=N+4 -> (s'=N+4);
endmodule

label "goal" = s=N+4;

rewards "cost"
    [enter] true : 1;
    [a_done] true : 1;
    [b_done] true : 9;
    [c_done] true : 5;
endrewards
