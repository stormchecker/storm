mdp

module main
    s : [0..3] init 0;

    [det] s=0 -> 1 : (s'=3);
    [lottery] s=0 -> 1/2 : (s'=1) + 1/2 : (s'=2);
    [low] s=1 -> 1 : (s'=3);
    [high] s=2 -> 1 : (s'=3);
    [] s=3 -> 1 : (s'=3);
endmodule

label "goal" = s=3;

rewards "reward"
    [det] true : 6;
    [lottery] true : 1;
    [low] true : 7;
    [high] true : 99;
endrewards
