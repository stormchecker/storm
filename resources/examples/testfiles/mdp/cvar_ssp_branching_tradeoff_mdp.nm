
mdp

module main
    s : [0..3] init 0;

    [safe] s=0 -> 1 : (s'=3);
    [risky] s=0 -> 1/2 : (s'=1) + 1/2 : (s'=2);
    [low] s=1 -> 1 : (s'=3);
    [high] s=2 -> 1 : (s'=3);
    [] s=3 -> 1 : (s'=3);
endmodule

label "goal" = s=3;

rewards "cost"
    [safe] true : 6;
    [risky] true : 1;
    [low] true : 1;
    [high] true : 7;
endrewards
